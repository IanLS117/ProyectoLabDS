<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="persistencePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>mx.desarrollo.entity.Usuario</class>
        <class>mx.desarrollo.entity.Rol</class>
        <class>mx.desarrollo.entity.Permiso</class>
        <class>mx.desarrollo.entity.UsuarioFinal</class>
        <class>mx.desarrollo.entity.Equipo</class>
        <class>mx.desarrollo.entity.TipoIncidencia</class>
        <class>mx.desarrollo.entity.Ticket</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3306/sigeti_sprint1?serverTimezone=UTC"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
        </properties>
    </persistence-unit>
</persistence>
